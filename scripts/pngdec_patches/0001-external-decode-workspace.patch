+// External workspaces retain the original decode algorithm and dictionary size.
+// All regions must be disjoint and live until close/reopen; zcfree remains a no-op.
+PNG_STATIC int PNGWorkspaceOverlaps(uintptr_t a, size_t an, uintptr_t b, size_t bn)
+{
+    return a < b + bn && b < a + an;
+}
+
+PNG_STATIC int PNGSetDecodeWorkspace(PNGIMAGE *pPNG, void *state, size_t stateBytes,
+                                    uint8_t *window, size_t windowBytes, uint8_t *rows, size_t rowBytes)
+{
+    if (!pPNG) return 0;
+    const uintptr_t a = (uintptr_t)state, b = (uintptr_t)window, c = (uintptr_t)rows;
+#ifdef __cplusplus
+    const size_t stateAlignment = alignof(struct inflate_state);
+#else
+    const size_t stateAlignment = _Alignof(struct inflate_state);
+#endif
+    pPNG->pInflateState = NULL;
+    pPNG->pInflateWindow = NULL;
+    pPNG->ucPixels = NULL;
+    pPNG->iPixelBufferSize = 0;
+    if (!state || !window || !rows || pPNG->iWidth <= 0 || pPNG->iHeight <= 0 ||
+        pPNG->iPitch <= 0 || pPNG->iPitch > PNG_MAX_BUFFERED_PIXELS ||
+        stateBytes < PNG_DECODE_STATE_BYTES || windowBytes < PNG_DECODE_WINDOW_BYTES ||
+        a % stateAlignment || b % sizeof(uint32_t) || c % PNG_DECODE_ROWS_ALIGNMENT ||
+        stateBytes > UINTPTR_MAX - a || windowBytes > UINTPTR_MAX - b || rowBytes > UINTPTR_MAX - c ||
+        PNGWorkspaceOverlaps(a, stateBytes, b, windowBytes) ||
+        PNGWorkspaceOverlaps(a, stateBytes, c, rowBytes) ||
+        PNGWorkspaceOverlaps(b, windowBytes, c, rowBytes)) {
+        pPNG->iError = PNG_INVALID_PARAMETER;
+        return 0;
+    }
+    const size_t needed = ((size_t)pPNG->iPitch + 1) * 2 + 32;
+    if (needed > PNG_MAX_BUFFERED_PIXELS || rowBytes < needed) {
+        pPNG->iError = PNG_NO_BUFFER;
+        return 0;
+    }
+    // open previously zeroed these embedded arrays. Preserve that initialization.
+    memset(state, 0, PNG_DECODE_STATE_BYTES);
+    memset(window, 0, PNG_DECODE_WINDOW_BYTES);
+    memset(rows, 0, needed);
+    pPNG->pInflateState = (struct inflate_state *)state;
+    pPNG->pInflateWindow = window;
+    pPNG->ucPixels = rows;
+    pPNG->iPixelBufferSize = rowBytes;
+    pPNG->iError = PNG_SUCCESS;
+    return 1;
+}
+
+#ifndef __cplusplus
+int PNG_setDecodeWorkspace(PNGIMAGE *pPNG, void *state, size_t stateBytes,
+                          uint8_t *window, size_t windowBytes, uint8_t *rows, size_t rowBytes)
+{
+    return PNGSetDecodeWorkspace(pPNG, state, stateBytes, window, windowBytes, rows, rowBytes);
+}
+#endif
